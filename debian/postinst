#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    echo "Configuring Van LAN Router..."
    # Ensure IP forwarding is enabled
    sysctl -w net.ipv4.ip_forward=1
    echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-vanlan-router.conf
    
    # Reload systemd and enable service
    systemctl daemon-reload
    systemctl enable vanlan-router.service
fi

exit 0
